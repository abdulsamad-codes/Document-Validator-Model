# API base URL for the FastAPI backend.
#
# Default: the axios client falls back to a relative `/api/v1`. In development
# the Vite dev server proxies `/api/v1` to http://localhost:8000 (see
# vite.config.js), so no environment variable is required locally.
#
# When the backend is hosted on a separate origin, copy this file to `.env.local`
# and set the absolute backend URL, e.g.:
#   VITE_API_BASE_URL=http://localhost:8000/api/v1
#
# Authentication uses HTTP-only cookies. The axios instance sends
# `withCredentials: true` and expects the backend to expose:
#   POST /api/v1/auth/login     (set access/refresh cookies)
#   GET  /api/v1/auth/me        (restore session)
#   POST /api/v1/auth/refresh   (rotate access cookie)
#   POST /api/v1/auth/logout    (clear cookies)
# On a separate origin the backend must also allow credentialed cross-origin
# requests (CORS with credentials).
VITE_API_BASE_URL=http://localhost:8000/api/v1
